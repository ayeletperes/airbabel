# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/

# Env / secrets
.env

# Ingestion / enrichment caches
/airrdb_cache/
/ogrdb_cache/
/imgt_crawl_cache/
/ncbi_cache/
/literature_cache/
/literature_supp_cache/
/imgt_genelect_cache/
# Review dossiers: regenerable from source_candidates.evidence. The durable
# audit record is the [approval] block in each manifest, which IS committed.
/source_dossiers/
/source_discovery_cache/
/analysis/cache/
/data/

# Local databases
*.sqlite
*.db

# Editor / backups
*.bak
*~

# Throwaway / experimental artifacts
/scratch/

# Public-release staging (assembled by scripts/build-public-repo.sh)
/build/

# Historical IMGT/GENE-DB release snapshots (Dropbox-synced, not in git)
imgt_history/

# Cached bulk IMGT/GENE-DB FASTA (Dropbox-synced, not in git)
imgt_genedb_ref.fasta
# The protein projection of the same download. Was missing here, so it showed up as
# an untracked file in every `git status` and invited being committed by accident --
# it is a 3 MB regenerable cache, like its nucleotide twin.
imgt_genedb_ref_aa.fasta
imgt_genedb_ref_gapped.fasta

# Pre-publication manuscripts — must stay OUT of the code repo
docs/manuscript.md
analysis/manuscript.md

# Agent worktrees and local tool state
.claude/

# Analysis working data: regenerable from the pinned snapshot, hundreds of MB.
# The code that builds them is tracked; the artefacts are not.
analysis/data/
analysis/cache/
analysis/logs/
analysis/notebooks/*.executed.ipynb

# Pre-publication manuscript, same rule as docs/manuscript.md
analysis/asc_manuscript.md
analysis/asc_manuscript.tex
analysis/asc_manuscript.bib

# KI-TCR source FASTAs, downloaded by ingest/ki_tcr.py. Regenerable, like every
# other source cache.
ki_tcr_cache/

# Generated by scripts/extract-site-text.py — output, not source.
SITE_TEXT.md

# Database snapshots written by deploy/spinup/build-artifact.sh. ~100 MB each and
# regenerable from the database; the durable copy belongs in object storage, not git.
artifacts/

# Docker: restore artifacts staged for the compose stack
/deploy/docker/restore/
